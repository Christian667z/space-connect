modules = ["web", "nodejs-20", "nix", "python-base-3.13"]
[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NODE_ENV = "production"
PORT = "5000"
SUPABASE_URL = "https://jkucbutsaivesayghhvq.supabase.co"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Backend && node server.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["node", "Backend/server.js"]
